@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="mb-4" aria-label="Connected bank feed">
    <h2 class="h4">Connected bank feed</h2>
    <p>Find and connect your US bank through Plaid. CommunityAmerica availability must be confirmed with the provider. Imported transactions stay in your Azure account and do not automatically post to the local ledger.</p>
    @if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
    <p role="status">@status</p>
    @if (configured)
    {
        <fieldset disabled="@busy">
            <legend class="visually-hidden">Bank connection controls</legend>
            <button class="btn btn-outline-primary" @onclick="SignIn">Sign in with Microsoft</button>
            @if (signedIn)
            {
                <button class="btn btn-primary ms-2" @onclick="() => Connect(null)">Connect bank / resume authorization</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="SignOut">Sign out</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="Refresh">Reload connections</button>
                @foreach (var connection in connections)
                {
                    <div class="border rounded p-3 mt-3" @key="connection.Id">
                        <p>Last sync: @(connection.LastSynced?.ToLocalTime().ToString("g") ?? "Not yet synced")</p>
                        <button class="btn btn-outline-primary" @onclick="() => Sync(connection.Id)">Sync transactions</button>
                        <button class="btn btn-outline-secondary ms-2" @onclick="() => Connect(connection.Id)">Reconnect</button>
                        <button class="btn btn-outline-danger ms-2" @onclick="() => Disconnect(connection.Id)">Disconnect &amp; delete feed</button>
                        @foreach (var account in connection.Accounts)
                        {
                            <p class="mt-2 mb-0"><button class="btn btn-link" @onclick="() => Select(connection.Id, account.Id)">@account.Name · @account.Mask</button></p>
                        }
                    </div>
                }
            }
        </fieldset>
        @if (selectedConnection is not null)
        {
            <h3 class="h5 mt-3">Bank transactions · review only</h3>
            <p>Positive amounts are money out; negative amounts are money in. Pending transactions may change. These are bank-feed records, not reconciled accounting entries.</p>
            @if (transactions.Count == 0) { <p>No transactions available. Initial bank history can take time; sync again later.</p> }
            else
            {
                <div class="table-responsive"><table class="table"><thead><tr><th>Select</th><th>Date</th><th>Description</th><th>Amount</th><th>Currency</th><th>Status</th></tr></thead><tbody>
                    @foreach (var row in transactions) { <tr><td><input type="checkbox" aria-label="Select transaction for export" disabled="@(busy || !Exportable(row))" @bind="row.Selected" /></td><td>@row.Date</td><td>@row.Name</td><td>@row.Amount.ToString("0.00##")</td><td>@(row.Currency ?? "Unspecified")</td><td>@(row.Pending ? "Pending" : "Posted at bank")</td></tr> }
                </tbody></table></div>
            }
            <p>Export posted USD transactions from a checking or savings account, then open local Ledger → Banking → Bank Transactions to import and review. Up to 100 rows from this page; pending, credit-card and non-USD rows cannot be exported. The file contains financial data; store it privately.</p>
            <button class="btn btn-outline-secondary" disabled="@busy" @onclick="SelectExportable">Select eligible rows on this page</button>
            <button class="btn btn-primary ms-2" disabled="@(busy || !transactions.Any(x => x.Selected && Exportable(x)))" @onclick="Export">Export selected for bookkeeping</button>
            <button class="btn btn-outline-secondary" disabled="@(busy || offset == 0)" @onclick="() => Page(-100)">Previous</button>
            <button class="btn btn-outline-secondary ms-2" disabled="@(busy || !hasMore)" @onclick="() => Page(100)">Next</button>
        }
    }
</section>

@code {
    private IJSObjectReference? module, feed;
    private bool configured, signedIn, busy, disposed, hasMore;
    private string status = "Loading bank connection settings…";
    private string? error;
    private List<Connection> connections = [];
    private List<Transaction> transactions = [];
    private Guid? selectedConnection;
    private string selectedAccount = "";
    private int offset;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bank-feed.js");
            if (disposed) { await module.DisposeAsync(); return; }
            feed = await module.InvokeAsync<IJSObjectReference?>("create");
            if (disposed) { if (feed is not null) { await feed.InvokeVoidAsync("dispose"); await feed.DisposeAsync(); } return; }
            configured = feed is not null;
            status = configured ? "Sign in to view or connect your bank. Live connections require a configured provider account." : "Bank connections are not configured yet. Set up the Azure API and public bank-config.json settings to enable sign-in.";
        }
        catch (JSException ex) { error = ex.Message.Split('\n')[0]; status = "Bank feed unavailable."; }
        if (!disposed) StateHasChanged();
    }

    private async Task Run(Func<Task> action)
    {
        if (busy || disposed || feed is null) return;
        busy = true; error = null;
        try { await action(); }
        catch (JSException ex) { error = ex.Message.Split('\n')[0]; status = signedIn ? "Signed in. The bank request did not complete; you can reload connections without signing in again." : "Bank request did not complete."; }
        finally { busy = false; }
    }
    private async Task Reload()
    {
        // Serverless Resume: Keep sign-in success visible while Azure SQL wakes up.
        status = "Signed in. Loading bank connections; Azure may need a minute to wake up.";
        StateHasChanged();
        connections = await feed!.InvokeAsync<List<Connection>>("connections");
    }
    private Task Refresh() => Run(async () => { await Reload(); status = "Signed in. Choose Connect bank or sync an existing connection."; });
    private Task SignIn() => Run(async () => { ClearRows(); signedIn = false; connections = []; await feed!.InvokeVoidAsync("signIn"); signedIn = true; await Reload(); status = "Signed in. Choose Connect bank or sync an existing connection."; });
    private Task SignOut() => Run(async () => { await feed!.InvokeVoidAsync("signOut"); signedIn = false; connections = []; ClearRows(); status = "Signed out of the bank feed."; });
    private Task Connect(Guid? id) => Run(async () =>
    {
        var connected = await feed!.InvokeAsync<Guid>("connect", id);
        await Reload();
        await feed!.InvokeVoidAsync("sync", connected);
        await Reload();
        status = "Bank connected. Select an account to review transactions; initial history may still be preparing.";
    });
    private Task Sync(Guid id) => Run(async () => { await feed!.InvokeVoidAsync("sync", id); await Reload(); if (selectedConnection == id) { offset = 0; await LoadRows(); } status = "Available bank updates saved. Select an account to review."; });
    private Task Disconnect(Guid id) => Run(async () => { if (await feed!.InvokeAsync<bool>("disconnect", id)) { ClearRows(); await Reload(); status = "Bank disconnected and imported feed deleted."; } });
    private Task Select(Guid id, string account) => Run(async () => { selectedConnection = id; selectedAccount = account; offset = 0; transactions = []; await LoadRows(); });
    private Task Page(int change) => Run(async () => { var previous = offset; offset += change; try { await LoadRows(); } catch { offset = previous; throw; } });
    private async Task LoadRows()
    {
        var page = await feed!.InvokeAsync<TransactionPage>("transactions", selectedConnection, selectedAccount, offset);
        transactions = page.Rows; hasMore = page.HasMore;
    }
    private bool Exportable(Transaction row) => !row.Pending && row.Currency == "USD" && row.Amount != 0
        && Math.Abs(row.Amount) <= 1000000m && row.Amount * 100m == decimal.Truncate(row.Amount * 100m)
        && connections.FirstOrDefault(x => x.Id == selectedConnection)?.Accounts.FirstOrDefault(x => x.Id == selectedAccount)?.Type == "depository";
    private void SelectExportable() { foreach (var row in transactions) row.Selected = Exportable(row); }
    private Task Export() => Run(async () =>
    {
        var rows = transactions.Where(x => x.Selected && Exportable(x)).Select(x => new { x.Id, x.Date, x.Name, amountCents = (long)(x.Amount * 100m), x.Currency, x.Pending }).ToArray();
        if (rows.Length == 0) return;
        await feed!.InvokeVoidAsync("exportFile", new { format = "aicraft-bank", version = 1, accountId = selectedAccount, transactions = rows });
        status = "Export downloaded. In local Ledger, open Banking → Bank Transactions, select the matching local bank account, and import the file for review.";
    });
    private void ClearRows() { transactions = []; selectedConnection = null; selectedAccount = ""; offset = 0; hasMore = false; }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (feed is not null) { await feed.InvokeVoidAsync("dispose"); await feed.DisposeAsync(); }
        if (module is not null) await module.DisposeAsync();
    }
    public sealed class Connection { public Guid Id { get; set; } public DateTimeOffset? LastSynced { get; set; } public List<BankAccount> Accounts { get; set; } = []; }
    public sealed class BankAccount
    {
        [System.Text.Json.Serialization.JsonPropertyName("account_id")] public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Mask { get; set; }
        public string Type { get; set; } = "";
    }
    public sealed class TransactionPage { public List<Transaction> Rows { get; set; } = []; public bool HasMore { get; set; } }
    public sealed class Transaction { public string Id { get; set; } = ""; public bool Selected { get; set; } public string Date { get; set; } = ""; public string Name { get; set; } = ""; public decimal Amount { get; set; } public string? Currency { get; set; } public bool Pending { get; set; } }
}
