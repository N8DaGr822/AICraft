<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <Content Include="../AITest/wwwroot/lib/bootstrap/dist/css/bootstrap.min.css" Link="wwwroot/bootstrap.min.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
