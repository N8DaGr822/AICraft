@inherits LayoutComponentBase
@inject NavigationManager Navigation
<a class="skip-link" href="@(Navigation.Uri.Split('#')[0] + "#main-content")">Skip to content</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/N8DaGr822/AICraft" target="_blank" rel="noopener noreferrer">Project &amp; documentation</a>
