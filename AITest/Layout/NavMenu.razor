<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AICraft</a>
        <button title="Navigation menu" aria-label="Navigation menu" aria-expanded="@((!collapseNavMenu).ToString().ToLowerInvariant())" aria-controls="app-navigation" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div id="app-navigation" class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="apps"><span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> All apps</NavLink>
        </div>
        @foreach (var app in AITest.Apps.AppCatalog.All)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@app.Route" Match="NavLinkMatch.All">
                    <span class="bi @app.Icon" aria-hidden="true"></span> @app.Name
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

