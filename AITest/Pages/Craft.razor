@page "/craft/{AppId}"

<PageTitle>AICraft · @(app?.Name ?? "App not found")</PageTitle>
@if (app is null)
{
    <h1>App not found</h1><p><a href="apps">Return to all apps</a>.</p>
}
else
{
    <div class="craft-heading"><h1>@app.Name</h1><a href="@BundleUrl">Standalone editor</a></div>
    @* Runtime Ownership: Route changes replace the frame and release the previous editor. *@
    <iframe @key="AppId" class="craft-editor" src="@BundleUrl" title="@($"{app.Name} browser editor")"
            allow="fullscreen; clipboard-read; clipboard-write; microphone" allowfullscreen></iframe>
    <details class="craft-help"><summary>Help &amp; notices</summary>
        <p>@app.Workflow Save or export before leaving. Files and storage are managed by the editor on this device.</p>
        <p>Browser build @app.Version. If it cannot start, try the standalone view and check your browser's graphics support.</p>
        @if (AppId == "effectcraft") { <p>Compatibility mode uses WebGL with background workers and offline caching disabled. Some effects may be slower.</p> }
        <a href="@($"https://github.com/storytold/{AppId}/releases/tag/v{app.Version}")">Release notes</a>
        <a href="@(BundleRoot + "/NOTICE")">Licenses &amp; notices</a>
    </details>
}

@code {
    [Parameter] public string AppId { get; set; } = "";
    private AITest.Apps.AppCatalog.Entry? app;
    private string BundleRoot => $"craft/{AppId}/{app!.Version}" + (AppId == "effectcraft" ? "-webgl" : "");
    private string BundleUrl => BundleRoot + "/index.html" + (AppId == "effectcraft" ? "?noworkers&nosw" : "");

    // Route Validation: Only registered, pinned editors can be embedded.
    protected override void OnParametersSet()
    {
        app = AITest.Apps.AppCatalog.All.FirstOrDefault(x => x.Route == $"craft/{AppId}" && x.Version is not null);
    }
}
